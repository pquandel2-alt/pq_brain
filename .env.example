# Brain — Konfiguration. Kopiere nach .env (lokal) oder /etc/default/pq-brain (systemd).
# Alle Werte haben sinnvolle Defaults; ohne .env läuft Brain unverändert.

# ── Server ────────────────────────────────────────────────────────────────
# PORT=3000

# ── Daten & Pfade ───────────────────────────────────────────────────────────
# Ein Verzeichnis für ALLES (DB, Backups, Logs, Modell-Cache). Im Container
# typischerweise /app/data (als Volume gemountet).
# BRAIN_DATA_DIR=./data
# Einzelnen DB-Ort überschreiben (sonst $BRAIN_DATA_DIR/brain.db):
# BRAIN_DB=
# Modell-Cache separat ablegen (sonst $BRAIN_DATA_DIR/models, falls DATA_DIR gesetzt;
# ohne beides: node_modules/.cache — bestehendes Verhalten):
# BRAIN_MODEL_CACHE=

# ── Einstieg / KI-Neutralität ───────────────────────────────────────────────
# Startknoten für /api/briefing & smart-Mode: ID oder Label. Leer = automatisch
# (Knoten mit Tag `start`, sonst Legacy-Labels).
# BRAIN_START_NODE=
# Tokenizer-Kalibrierung für die Recall-Budget-SCHÄTZUNG (Zeichen pro Token,
# geklemmt auf 1–20). Pro Request via ?charsPerToken überschreibbar.
# BRAIN_CHARS_PER_TOKEN=4

# ── Embeddings / Retrieval ──────────────────────────────────────────────────
# BRAIN_EMBED_MODEL=Xenova/bge-m3
# BRAIN_EMBED_DIM=1024
# BRAIN_EMBED_DTYPE=q8
# BRAIN_RERANK_MODEL=Xenova/bge-reranker-base
# BRAIN_RERANK_DTYPE=q8
# BRAIN_DEDUP_DISTANCE=0.12
# BRAIN_AUTO_LINK_SIM=0.9

# ── MCP (optional) ──────────────────────────────────────────────────────────
# Bearer-Token für /mcp (leer = offen). Security ist sonst nicht Teil dieser Config.
# BRAIN_MCP_TOKEN=

# ── Auto-Capture (SessionEnd Hook) ──────────────────────────────────────────
# Extrahiert automatisch Wissen aus KI-Session-Transcripts.
# Backend: ollama (lokal, empfohlen) oder claude (Claude Code Abo).
# Einrichten: ./install.sh (interaktiv) oder manuell:
#   cp examples/hooks/brain-capture.sh ~/.claude/hooks/
#   chmod +x ~/.claude/hooks/brain-capture.sh
#   # SessionEnd-Hook in ~/.claude/settings.json registrieren (siehe README)
#
# BRAIN_CAPTURE_BACKEND=ollama
# OLLAMA_URL=http://localhost:11434
# BRAIN_CAPTURE_OLLAMA_MODEL=qwen2.5:3b   # oder llama3.2:3b, phi4-mini, mistral:7b
# BRAIN_CAPTURE_OLLAMA_TIMEOUT=1800       # Sekunden; auf langsamen VMs mehr Zeit
# BRAIN_CAPTURE_MIN_MESSAGES=10           # Sessions kürzer als N überspringen
# BRAIN_CAPTURE_MAX_CHARS=30000           # Transcript-Zeichen ans Modell senden
# BRAIN_CAPTURE_LOG=~/.claude/hooks/brain-capture.log
