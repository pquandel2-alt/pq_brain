[Unit]
Description=pq_brain - AI Agent Knowledge Graph Server
After=network.target

[Service]
Type=simple
# __USER__ und __DIR__ werden von setup-service.sh durch den echten Nutzer/Pfad
# ersetzt. Diese Datei ist eine Vorlage — nicht direkt nach /etc kopieren.
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/env node __DIR__/server.js
Restart=always
RestartSec=10
# Optionale Env-Overrides (BRAIN_DATA_DIR, PORT, BRAIN_MODEL_CACHE, ...).
# Das führende "-" macht die Datei optional — fehlt sie, gelten die Defaults.
EnvironmentFile=-/etc/default/pq-brain
Environment="NODE_ENV=production"

[Install]
WantedBy=multi-user.target
